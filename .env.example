# ---- DeepSeek (server-side only) ----
# 必填才会启用真实 AI 分析；未配置时应用进入明确标记的「示例模式」。
DEEPSEEK_API_KEY=

# 可选：覆盖默认值（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 结构化抽取默认关闭思考模式；max_tokens 默认 8192；超时默认 45000ms
# DEEPSEEK_MAX_TOKENS=8192
# DEEPSEEK_TIMEOUT_MS=45000

# 可选：SQLite 文件路径，默认 ./data/flowback.db
# FLOWBACK_DB=./data/flowback.db

# ---- R3 auth (server-side only) ----
# Local web admin cookie token. Generate with: openssl rand -base64 32
FLOWBACK_LOCAL_TOKEN=
# Enable the local-only dev identity endpoint for WeChat DevTools/H5 preview.
# MUST be 0 in production; it is rejected for non-local hosts.
FLOWBACK_DEV_AUTH=0
# WeChat login: server exchanges wx.login code for openid. Never put the secret in miniapp.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
